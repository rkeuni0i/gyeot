# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environment variables & secrets
.env
*.env
.env.*
!.env.example
.streamlit/secrets.toml

# IDE & Editor settings
.claude/
.vscode/
.idea/
*.swp
*.swo

# Logs & conversation history
*.log
logs/*.jsonl
logs/conversations/*.json
!logs/.gitkeep
!logs/conversations/.gitkeep

# OCR cache
data/ocr/*.json
!data/ocr/.gitkeep

# SQLite temporary / lock files
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm

# OS specific files
Thumbs.db
Desktop.ini
.DS_Store

# Virtual environments
venv/
.venv/
env/

# Doc agent inbox upload staging
doc_agent/inbox/*
!doc_agent/inbox/.gitkeep

# Legacy index backups
index/legacy_backup/

# Archives
*.zip
