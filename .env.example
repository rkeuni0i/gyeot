# [인증 방식: Google Cloud ADC (권장)]
# 터미널에서 다음 명령어로 로그인하면 API 키 없이 ADC 방식으로 작동합니다:
#   gcloud auth login
#   gcloud auth application-default login
#   gcloud config set project [PROJECT_ID]

# Google Cloud 설정 (선택, ADC 기본값 사용 시 주석 유지)
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global   # gemini-3.8-flash는 global에만 있음(asia-northeast3는 404)

# 모델 설정 (선택, 기본값: gemini-3.8-flash)
MINDGUIDE_MODEL=gemini-3.8-flash

# [대체 인증 방식: Gemini API Key (선택)]
# ADC 대신 API Key를 사용할 때만 아래 주석을 풀고 키를 입력하세요.
# GEMINI_API_KEY=your_gemini_api_key_here

